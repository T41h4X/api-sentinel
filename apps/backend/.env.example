# Service-specific values; root .env is loaded by Docker Compose.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://api_sentinel:change-me-in-production@localhost:5432/api_sentinel?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
