{
  "name": "api-sentinel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "corepack pnpm --filter @api-sentinel/shared build && corepack pnpm --filter backend build && corepack pnpm --filter frontend build",
    "dev": "concurrently -n backend,frontend -c blue,green \"corepack pnpm --filter backend dev\" \"corepack pnpm --filter frontend dev\"",
    "dev:backend": "corepack pnpm --filter backend dev",
    "dev:frontend": "corepack pnpm --filter frontend dev",
    "lint": "corepack pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "db:generate": "corepack pnpm --filter backend prisma:generate",
    "db:migrate": "corepack pnpm --filter backend prisma:migrate",
    "db:seed": "corepack pnpm --filter backend prisma:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "typescript-eslint": "^8.30.1",
    "typescript": "^5.7.3"
  }
}
