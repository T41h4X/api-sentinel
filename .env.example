# Shared development defaults. Copy to .env and replace all secret values.
POSTGRES_DB=api_sentinel
POSTGRES_USER=api_sentinel
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3001
FRONTEND_PORT=3000
DATABASE_URL=postgresql://api_sentinel:change-me-in-production@localhost:5432/api_sentinel?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
